# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
OLLAMA_BASE_URL='http://localhost:11434'

# REQUIRED: Secret key for signing JWT authentication tokens.
# Generate with: openssl rand -hex 32
# An empty or missing key allows anyone to forge login tokens — never leave this blank.
WEBUI_SECRET_KEY=''

# Host port that Open WebUI listens on (default: 8080, bound to 127.0.0.1 only)
# Access is via Nginx reverse proxy — do NOT expose this port publicly.
OPEN_WEBUI_PORT=8080

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false