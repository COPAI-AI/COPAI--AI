{
  "title": "Energy & Cost Monitor",
  "uid": "copai-energy",
  "tags": ["copai", "energy", "cost"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "electricity_price_usd",
        "label": "Electricity (USD/kWh)",
        "type": "textbox",
        "current": {"value": "0.152"},
        "hide": 0
      },
      {
        "name": "usd_to_khr",
        "label": "USD → KHR Rate",
        "type": "textbox",
        "current": {"value": "4000"},
        "hide": 0
      },
      {
        "name": "server_idle_watts",
        "label": "Server Idle Watts (non-GPU)",
        "type": "textbox",
        "current": {"value": "200"},
        "hide": 0
      },
      {
        "name": "currency",
        "label": "Currency",
        "type": "custom",
        "query": "USD : 0, KHR : 1",
        "current": {"value": "0", "text": "USD"},
        "options": [
          {"value": "0", "text": "USD", "selected": true},
          {"value": "1", "text": "KHR", "selected": false}
        ],
        "hide": 0
      }
    ]
  },
  "panels": [

    {"id": 100, "type": "row", "title": "Live — Right Now", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1}, "collapsed": false},

    {
      "id": 1, "type": "stat", "title": "Live GPU Power (W)",
      "gridPos": {"x": 0, "y": 1, "w": 4, "h": 4},
      "fieldConfig": {"defaults": {"unit": "watt",
        "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 200}, {"color": "red", "value": 300}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "DCGM_FI_DEV_POWER_USAGE", "legendFormat": "GPU W"}]
    },
    {
      "id": 2, "type": "stat", "title": "Total System Power Est. (W)",
      "description": "GPU + server idle estimate",
      "gridPos": {"x": 4, "y": 1, "w": 4, "h": 4},
      "fieldConfig": {"defaults": {"unit": "watt",
        "thresholds": {"steps": [{"color": "blue", "value": 0}, {"color": "orange", "value": 400}, {"color": "red", "value": 600}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "DCGM_FI_DEV_POWER_USAGE + $server_idle_watts", "legendFormat": "Total W"}]
    },
    {
      "id": 3, "type": "stat", "title": "GPU Idle Baseline (W)",
      "gridPos": {"x": 8, "y": 1, "w": 4, "h": 4},
      "fieldConfig": {"defaults": {"unit": "watt",
        "thresholds": {"steps": [{"color": "blue", "value": 0}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "min_over_time(DCGM_FI_DEV_POWER_USAGE[1h])",
        "legendFormat": "Idle baseline"}]
    },
    {
      "id": 4, "type": "stat", "title": "Cost Per 1000 Tokens",
      "description": "Only shown during active inference. Formula: (Watts/1000 × $/kWh / 3600) / (tokens/s) × 1000",
      "gridPos": {"x": 12, "y": 1, "w": 4, "h": 4},
      "fieldConfig": {"defaults": {"decimals": 6,
        "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.001}, {"color": "red", "value": 0.01}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "(\n  (DCGM_FI_DEV_POWER_USAGE + $server_idle_watts) / 1000 * $electricity_price_usd / 3600\n) / scalar(sum(rate(vllm:generation_tokens_total[1m])) > 0) * 1000 * (1 + $currency * ($usd_to_khr - 1))",
        "legendFormat": "per 1k tokens"}]
    },
    {
      "id": 5, "type": "stat", "title": "vs GPT-4o API",
      "description": "% cheaper than GPT-4o output pricing ($0.010/1k tokens). Only during inference.",
      "gridPos": {"x": 16, "y": 1, "w": 4, "h": 4},
      "fieldConfig": {"defaults": {"decimals": 1, "unit": "percent",
        "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 50}, {"color": "green", "value": 80}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "(1 - (\n  (DCGM_FI_DEV_POWER_USAGE + $server_idle_watts) / 1000 * $electricity_price_usd / 3600\n  / scalar(sum(rate(vllm:generation_tokens_total[1m])) > 0) * 1000\n) / 0.010) * 100",
        "legendFormat": "% cheaper"}]
    },
    {
      "id": 6, "type": "stat", "title": "Projected Monthly Cost",
      "gridPos": {"x": 20, "y": 1, "w": 4, "h": 4},
      "fieldConfig": {"defaults": {"decimals": 2,
        "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 30}, {"color": "red", "value": 60}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "(\n  (DCGM_FI_DEV_POWER_USAGE + $server_idle_watts) / 1000\n) * 24 * 30 * $electricity_price_usd * (1 + $currency * ($usd_to_khr - 1))",
        "legendFormat": "Monthly"}]
    },

    {"id": 101, "type": "row", "title": "Cost Summary", "gridPos": {"x": 0, "y": 5, "w": 24, "h": 1}, "collapsed": false},

    {
      "id": 7, "type": "stat", "title": "Energy Used Today (kWh)",
      "gridPos": {"x": 0, "y": 6, "w": 4, "h": 4},
      "fieldConfig": {"defaults": {"unit": "kwatth", "decimals": 3,
        "thresholds": {"steps": [{"color": "blue", "value": 0}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "increase(DCGM_FI_DEV_TOTAL_ENERGY_CONSUMPTION[24h]) / 1e6 / 3600 + ($server_idle_watts * 24 / 1000)",
        "legendFormat": "kWh today"}]
    },
    {
      "id": 8, "type": "stat", "title": "Cost Today",
      "gridPos": {"x": 4, "y": 6, "w": 4, "h": 4},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"decimals": 2,
        "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 2}, {"color": "red", "value": 5}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "(\n  increase(DCGM_FI_DEV_TOTAL_ENERGY_CONSUMPTION[24h]) / 1e6 / 3600\n  + ($server_idle_watts * 24 / 1000)\n) * $electricity_price_usd * (1 + $currency * ($usd_to_khr - 1))",
        "legendFormat": "Today"}]
    },
    {
      "id": 9, "type": "stat", "title": "Cost This Week",
      "gridPos": {"x": 8, "y": 6, "w": 4, "h": 4},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"decimals": 2,
        "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 10}, {"color": "red", "value": 20}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "(\n  increase(DCGM_FI_DEV_TOTAL_ENERGY_CONSUMPTION[7d]) / 1e6 / 3600\n  + ($server_idle_watts * 24 * 7 / 1000)\n) * $electricity_price_usd * (1 + $currency * ($usd_to_khr - 1))",
        "legendFormat": "This Week"}]
    },
    {
      "id": 10, "type": "stat", "title": "Cost This Month",
      "gridPos": {"x": 12, "y": 6, "w": 4, "h": 4},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"decimals": 2,
        "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 30}, {"color": "red", "value": 60}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "(\n  increase(DCGM_FI_DEV_TOTAL_ENERGY_CONSUMPTION[30d]) / 1e6 / 3600\n  + ($server_idle_watts * 24 * 30 / 1000)\n) * $electricity_price_usd * (1 + $currency * ($usd_to_khr - 1))",
        "legendFormat": "This Month"}]
    },
    {
      "id": 11, "type": "stat", "title": "Cost Per Request Today",
      "description": "Average electricity cost per AI request",
      "gridPos": {"x": 16, "y": 6, "w": 4, "h": 4},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"decimals": 4,
        "thresholds": {"steps": [{"color": "green", "value": 0}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "(\n  increase(DCGM_FI_DEV_TOTAL_ENERGY_CONSUMPTION[24h]) / 1e6 / 3600\n  + ($server_idle_watts * 24 / 1000)\n) * $electricity_price_usd * (1 + $currency * ($usd_to_khr - 1))\n/ clamp_min(increase(vllm:request_success_total[24h]), 1)",
        "legendFormat": "Per request"}]
    },
    {
      "id": 12, "type": "stat", "title": "Total Requests Today",
      "gridPos": {"x": 20, "y": 6, "w": 4, "h": 4},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"decimals": 0,
        "thresholds": {"steps": [{"color": "blue", "value": 0}, {"color": "green", "value": 10}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "increase(vllm:request_success_total[24h])",
        "legendFormat": "Requests"}]
    },

    {"id": 102, "type": "row", "title": "Power & Cost Charts", "gridPos": {"x": 0, "y": 10, "w": 24, "h": 1}, "collapsed": false},

    {
      "id": 13, "type": "timeseries", "title": "Power Draw Over Time (W)",
      "gridPos": {"x": 0, "y": 11, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "watt"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "DCGM_FI_DEV_POWER_USAGE", "legendFormat": "GPU Power"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "DCGM_FI_DEV_POWER_USAGE + $server_idle_watts", "legendFormat": "Total Est."}
      ]
    },
    {
      "id": 14, "type": "timeseries", "title": "Cumulative Cost Over Time",
      "gridPos": {"x": 12, "y": 11, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"decimals": 4}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "(\n  increase(DCGM_FI_DEV_TOTAL_ENERGY_CONSUMPTION[$__range]) / 1e6 / 3600\n  + ($server_idle_watts * ($__range_s / 3600) / 1000)\n) * $electricity_price_usd",
          "legendFormat": "Cumulative USD"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "(\n  increase(DCGM_FI_DEV_TOTAL_ENERGY_CONSUMPTION[$__range]) / 1e6 / 3600\n  + ($server_idle_watts * ($__range_s / 3600) / 1000)\n) * $electricity_price_usd * $usd_to_khr",
          "legendFormat": "Cumulative KHR"}
      ]
    },

    {"id": 103, "type": "row", "title": "Efficiency", "gridPos": {"x": 0, "y": 19, "w": 24, "h": 1}, "collapsed": false},

    {
      "id": 15, "type": "timeseries", "title": "GPU Utilization vs Power (Efficiency)",
      "description": "High utilization at same power = efficient. Low util at high power = idle waste.",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "DCGM_FI_DEV_GPU_UTIL", "legendFormat": "GPU Util %"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "DCGM_FI_DEV_POWER_USAGE / 300 * 100", "legendFormat": "Power % of 300W TDP"}
      ]
    },
    {
      "id": 16, "type": "timeseries", "title": "Cost Per Hour (running rate)",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"decimals": 4}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "(DCGM_FI_DEV_POWER_USAGE + $server_idle_watts) / 1000 * $electricity_price_usd",
          "legendFormat": "USD/hr"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "(DCGM_FI_DEV_POWER_USAGE + $server_idle_watts) / 1000 * $electricity_price_usd * $usd_to_khr",
          "legendFormat": "KHR/hr"}
      ]
    }
  ]
}
