{
  "title": "Operations",
  "uid": "copai-ops",
  "tags": ["copai", "operations"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "5s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [

    {"id": 100, "type": "row", "title": "GPU Status", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1}, "collapsed": false},

    {
      "id": 1, "type": "gauge", "title": "GPU Utilization %",
      "gridPos": {"x": 0, "y": 1, "w": 4, "h": 4},
      "fieldConfig": {"defaults": {"min": 0, "max": 100, "unit": "percent",
        "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "DCGM_FI_DEV_GPU_UTIL", "legendFormat": "GPU {{gpu}}"}]
    },
    {
      "id": 2, "type": "gauge", "title": "GPU Memory Usage %",
      "gridPos": {"x": 4, "y": 1, "w": 4, "h": 4},
      "fieldConfig": {"defaults": {"min": 0, "max": 100, "unit": "percent",
        "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 75}, {"color": "red", "value": 90}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "DCGM_FI_DEV_FB_USED / (DCGM_FI_DEV_FB_USED + DCGM_FI_DEV_FB_FREE) * 100", "legendFormat": "Mem Used %"}]
    },
    {
      "id": 3, "type": "stat", "title": "GPU Memory Used",
      "gridPos": {"x": 8, "y": 1, "w": 4, "h": 4},
      "fieldConfig": {"defaults": {"unit": "decmbytes",
        "thresholds": {"steps": [{"color": "blue", "value": 0}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "DCGM_FI_DEV_FB_USED", "legendFormat": "Used MiB"}]
    },
    {
      "id": 4, "type": "stat", "title": "GPU Memory Free",
      "gridPos": {"x": 12, "y": 1, "w": 4, "h": 4},
      "fieldConfig": {"defaults": {"unit": "decmbytes",
        "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 3000}, {"color": "red", "value": 1000}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "DCGM_FI_DEV_FB_FREE", "legendFormat": "Free MiB"}]
    },
    {
      "id": 5, "type": "stat", "title": "GPU Temperature (°C)",
      "gridPos": {"x": 16, "y": 1, "w": 4, "h": 4},
      "fieldConfig": {"defaults": {"unit": "celsius",
        "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 75}, {"color": "red", "value": 85}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "DCGM_FI_DEV_GPU_TEMP", "legendFormat": "Temp"}]
    },
    {
      "id": 6, "type": "stat", "title": "GPU Power (W)",
      "gridPos": {"x": 20, "y": 1, "w": 4, "h": 4},
      "fieldConfig": {"defaults": {"unit": "watt",
        "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 200}, {"color": "red", "value": 280}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "DCGM_FI_DEV_POWER_USAGE", "legendFormat": "Power W"}]
    },

    {"id": 101, "type": "row", "title": "vLLM Status", "gridPos": {"x": 0, "y": 5, "w": 24, "h": 1}, "collapsed": false},

    {
      "id": 7, "type": "stat", "title": "Running Requests",
      "gridPos": {"x": 0, "y": 6, "w": 4, "h": 4},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 20}, {"color": "red", "value": 35}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "vllm:num_requests_running", "legendFormat": "Running"}]
    },
    {
      "id": 8, "type": "stat", "title": "Waiting Requests",
      "gridPos": {"x": 4, "y": 6, "w": 4, "h": 4},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 10}, {"color": "red", "value": 30}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "vllm:num_requests_waiting", "legendFormat": "Waiting"}]
    },
    {
      "id": 9, "type": "gauge", "title": "KV Cache Usage %",
      "gridPos": {"x": 8, "y": 6, "w": 4, "h": 4},
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "unit": "percentunit",
        "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.7}, {"color": "red", "value": 0.9}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "vllm:kv_cache_usage_perc", "legendFormat": "KV Cache"}]
    },
    {
      "id": 10, "type": "stat", "title": "Total Tokens Generated",
      "gridPos": {"x": 12, "y": 6, "w": 4, "h": 4},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "blue", "value": 0}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "vllm:generation_tokens_total", "legendFormat": "Total"}]
    },
    {
      "id": 11, "type": "stat", "title": "Requests Last Hour",
      "gridPos": {"x": 16, "y": 6, "w": 4, "h": 4},
      "fieldConfig": {"defaults": {"decimals": 0, "thresholds": {"steps": [{"color": "blue", "value": 0}, {"color": "green", "value": 5}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "increase(vllm:request_success_total[1h])", "legendFormat": "Last hr"}]
    },
    {
      "id": 12, "type": "stat", "title": "Avg Response Time (p50)",
      "gridPos": {"x": 20, "y": 6, "w": 4, "h": 4},
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 2,
        "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 5}, {"color": "red", "value": 15}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "histogram_quantile(0.5, rate(vllm:e2e_request_latency_seconds_bucket[5m]))",
        "legendFormat": "p50"}]
    },

    {"id": 102, "type": "row", "title": "GPU Charts", "gridPos": {"x": 0, "y": 10, "w": 24, "h": 1}, "collapsed": false},

    {
      "id": 13, "type": "timeseries", "title": "GPU Utilization & Memory Over Time",
      "gridPos": {"x": 0, "y": 11, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "DCGM_FI_DEV_GPU_UTIL", "legendFormat": "GPU Util %"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "DCGM_FI_DEV_FB_USED / (DCGM_FI_DEV_FB_USED + DCGM_FI_DEV_FB_FREE) * 100", "legendFormat": "Mem Used %"}
      ]
    },
    {
      "id": 14, "type": "timeseries", "title": "GPU Temperature & Power",
      "gridPos": {"x": 12, "y": 11, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "DCGM_FI_DEV_GPU_TEMP", "legendFormat": "Temp °C"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "DCGM_FI_DEV_POWER_USAGE", "legendFormat": "Power W"}
      ]
    },

    {"id": 103, "type": "row", "title": "vLLM Charts", "gridPos": {"x": 0, "y": 19, "w": 24, "h": 1}, "collapsed": false},

    {
      "id": 15, "type": "timeseries", "title": "Token Throughput (tokens/s)",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "rate(vllm:prompt_tokens_total[1m])", "legendFormat": "Input tokens/s"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "rate(vllm:generation_tokens_total[1m])", "legendFormat": "Output tokens/s"}
      ]
    },
    {
      "id": 16, "type": "timeseries", "title": "Response Latency",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.5, rate(vllm:e2e_request_latency_seconds_bucket[5m]))", "legendFormat": "E2E p50"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, rate(vllm:e2e_request_latency_seconds_bucket[5m]))", "legendFormat": "E2E p95"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.5, rate(vllm:time_to_first_token_seconds_bucket[5m]))", "legendFormat": "TTFT p50"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.5, rate(vllm:request_time_per_output_token_seconds_bucket[5m]))", "legendFormat": "Per-token p50"}
      ]
    },
    {
      "id": 17, "type": "timeseries", "title": "Active Requests Over Time",
      "gridPos": {"x": 0, "y": 28, "w": 24, "h": 6},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "vllm:num_requests_running", "legendFormat": "Running"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "vllm:num_requests_waiting", "legendFormat": "Waiting"}
      ]
    }
  ]
}
