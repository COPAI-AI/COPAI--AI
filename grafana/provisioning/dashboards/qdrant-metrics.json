{
  "title": "Qdrant Metrics",
  "uid": "copai-qdrant",
  "tags": ["copai", "vector-db"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Total Collections",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "blue", "value": 0}]}}},
      "targets": [{"datasource": "Prometheus", "expr": "qdrant_collections_total", "legendFormat": "Collections"}]
    },
    {
      "id": 2, "type": "stat", "title": "Total Vectors",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "blue", "value": 0}]}}},
      "targets": [{"datasource": "Prometheus", "expr": "qdrant_vectors_total", "legendFormat": "Vectors"}]
    },
    {
      "id": 3, "type": "stat", "title": "gRPC Requests Total",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "blue", "value": 0}]}}},
      "targets": [{"datasource": "Prometheus", "expr": "sum(grpc_server_handled_total)", "legendFormat": "Total"}]
    },
    {
      "id": 4, "type": "stat", "title": "REST Requests Total",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "blue", "value": 0}]}}},
      "targets": [{"datasource": "Prometheus", "expr": "sum(rest_responses_total)", "legendFormat": "Total"}]
    },
    {
      "id": 5, "type": "timeseries", "title": "Request Rate (req/s)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "targets": [
        {"datasource": "Prometheus", "expr": "rate(rest_responses_total[2m])", "legendFormat": "REST {{method}} {{status}}"},
        {"datasource": "Prometheus", "expr": "rate(grpc_server_handled_total[2m])", "legendFormat": "gRPC {{grpc_method}}"}
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "REST Response Time (seconds)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {"datasource": "Prometheus", "expr": "histogram_quantile(0.5, rate(rest_response_time_seconds_bucket[5m]))", "legendFormat": "p50"},
        {"datasource": "Prometheus", "expr": "histogram_quantile(0.95, rate(rest_response_time_seconds_bucket[5m]))", "legendFormat": "p95"},
        {"datasource": "Prometheus", "expr": "histogram_quantile(0.99, rate(rest_response_time_seconds_bucket[5m]))", "legendFormat": "p99"}
      ]
    }
  ]
}
