{
  "title": "Qdrant Metrics",
  "uid": "copai-qdrant",
  "tags": ["copai", "vector-db"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Total Collections",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "blue", "value": 0}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "collections_total", "legendFormat": "Collections"}]
    },
    {
      "id": 2, "type": "stat", "title": "Total Vectors",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "blue", "value": 0}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "collections_vector_total", "legendFormat": "Vectors"}]
    },
    {
      "id": 3, "type": "timeseries", "title": "Collection CPU Usage (ms/s)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "fieldConfig": {"defaults": {"unit": "ms", "custom": {"drawStyle": "line", "fillOpacity": 10}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "rate(collection_hardware_metric_cpu[2m]) / 1e6", "legendFormat": "{{id}}"}]
    },
    {
      "id": 4, "type": "stat", "title": "REST Requests Total",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "blue", "value": 0}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rest_responses_total)", "legendFormat": "Total"}]
    },
    {
      "id": 5, "type": "timeseries", "title": "Request Rate (req/s)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "rate(rest_responses_total[2m])", "legendFormat": "{{method}} {{endpoint}} {{status}}"}
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "REST Response Time (seconds)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.5, rate(rest_responses_duration_seconds_bucket[5m]))", "legendFormat": "p50"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, rate(rest_responses_duration_seconds_bucket[5m]))", "legendFormat": "p95"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.99, rate(rest_responses_duration_seconds_bucket[5m]))", "legendFormat": "p99"}
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Qdrant Memory",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"drawStyle": "line", "fillOpacity": 10}}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "memory_active_bytes", "legendFormat": "Active"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "memory_resident_bytes", "legendFormat": "Resident"}
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Vector I/O Rate",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"drawStyle": "line", "fillOpacity": 10}}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "rate(collection_hardware_metric_vector_io_write[2m])", "legendFormat": "write {{id}}"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "rate(collection_hardware_metric_vector_io_read[2m])", "legendFormat": "read {{id}}"}
      ]
    }
  ]
}
