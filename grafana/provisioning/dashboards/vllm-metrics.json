{
  "title": "vLLM Metrics",
  "uid": "copai-vllm",
  "tags": ["copai", "llm"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "5s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Running Requests",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 20}, {"color": "red", "value": 35}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "vllm:num_requests_running", "legendFormat": "Running"}]
    },
    {
      "id": 2, "type": "stat", "title": "Waiting Requests",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 10}, {"color": "red", "value": 30}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "vllm:num_requests_waiting", "legendFormat": "Waiting"}]
    },
    {
      "id": 3, "type": "gauge", "title": "KV Cache Usage %",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "unit": "percentunit",
        "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.7}, {"color": "red", "value": 0.9}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "vllm:kv_cache_usage_perc", "legendFormat": "KV Cache"}]
    },
    {
      "id": 4, "type": "stat", "title": "Total Tokens Generated",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "blue", "value": 0}]}}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "vllm:generation_tokens_total", "legendFormat": "Total Generated"}]
    },
    {
      "id": 5, "type": "timeseries", "title": "Request Throughput (req/s)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "rate(vllm:request_success_total[1m])", "legendFormat": "Success/s"}
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Token Throughput (tokens/s)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "rate(vllm:prompt_tokens_total[1m])", "legendFormat": "Prompt tokens/s"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "rate(vllm:generation_tokens_total[1m])", "legendFormat": "Generation tokens/s"}
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Time to First Token (seconds)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.5, rate(vllm:time_to_first_token_seconds_bucket[5m]))", "legendFormat": "p50"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, rate(vllm:time_to_first_token_seconds_bucket[5m]))", "legendFormat": "p95"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.99, rate(vllm:time_to_first_token_seconds_bucket[5m]))", "legendFormat": "p99"}
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Time Per Output Token (seconds)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.5, rate(vllm:request_time_per_output_token_seconds_bucket[5m]))", "legendFormat": "p50"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, rate(vllm:request_time_per_output_token_seconds_bucket[5m]))", "legendFormat": "p95"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.99, rate(vllm:request_time_per_output_token_seconds_bucket[5m]))", "legendFormat": "p99"}
      ]
    },
    {
      "id": 9, "type": "timeseries", "title": "Active Requests Over Time",
      "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "vllm:num_requests_running", "legendFormat": "Running"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "vllm:num_requests_waiting", "legendFormat": "Waiting"}
      ]
    },
    {
      "id": 10, "type": "timeseries", "title": "Prefix Cache Hit Rate (%)",
      "description": "Higher = more reuse of previously computed KV cache. Low hit rate means users are sending mostly unique prompts.",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100,
        "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 50}, {"color": "green", "value": 80}]},
        "custom": {"fillOpacity": 15, "lineWidth": 2}}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "rate(vllm:prefix_cache_hits_total[5m]) / clamp_min(rate(vllm:prefix_cache_queries_total[5m]), 0.001) * 100",
          "legendFormat": "Hit Rate %"}
      ]
    },
    {
      "id": 11, "type": "timeseries", "title": "Request Latency Breakdown (p50)",
      "description": "Shows where time is spent per request: waiting in queue, prefill (processing prompt), and decode (generating tokens).",
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"fillOpacity": 10, "lineWidth": 2, "stacking": {"mode": "normal"}}}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.5, rate(vllm:request_queue_time_seconds_bucket[5m]))",
          "legendFormat": "Queue Wait"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.5, rate(vllm:request_prefill_time_seconds_bucket[5m]))",
          "legendFormat": "Prefill"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.5, rate(vllm:request_decode_time_seconds_bucket[5m]))",
          "legendFormat": "Decode"}
      ]
    },
    {
      "id": 12, "type": "timeseries", "title": "Inter-Token Latency (Streaming Speed)",
      "description": "Time between consecutive tokens streamed to the user. Lower = faster perceived output. p95 shows worst-case streaming jitter.",
      "gridPos": {"x": 0, "y": 36, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 2}}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.5, rate(vllm:inter_token_latency_seconds_bucket[5m]))",
          "legendFormat": "p50"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.95, rate(vllm:inter_token_latency_seconds_bucket[5m]))",
          "legendFormat": "p95"}
      ]
    },
    {
      "id": 13, "type": "stat", "title": "Request Preemptions (5m)",
      "description": "Requests evicted mid-generation due to GPU KV cache pressure. Non-zero = GPU memory is being over-committed.",
      "gridPos": {"x": 12, "y": 36, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"decimals": 0,
        "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]},
        "color": {"mode": "thresholds"}}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "increase(vllm:num_preemptions_total[5m])",
          "legendFormat": "Preemptions"}
      ]
    }
  ]
}
